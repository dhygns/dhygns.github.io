---
import Base from "~/layouts/Base.astro";
import { awards, certificates } from "~/data/awards";
---

<Base
  title="Awards — Donghyeon Kim"
  description="iF Design Award 2024, iF Design Award 2018, Stellantis Venture Awards 2024, Samsung SW Expert."
>
  <section class="container-x pt-32 pb-12">
    <p class="t-meta mb-3">[ awards ]</p>
    <h1 class="t-h1 max-w-3xl" style="color: var(--color-text-0)">
      Recognition for prototype work that shipped.
    </h1>
  </section>

  <section class="container-x pb-20">
    <ul class="space-y-6">
      {
        awards.map((a) => (
          <li
            class="rounded-2xl border p-8 transition-colors"
            style="border-color: var(--color-border); background: var(--color-bg-1);"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h2
                class="text-xl font-semibold leading-snug"
                style="color: var(--color-text-0)"
              >
                {a.title}
              </h2>
              <span
                class="shrink-0 font-mono text-xs"
                style="color: var(--color-brand-500)"
              >
                {a.year}
              </span>
            </div>
            <p
              class="mt-1 font-mono text-xs"
              style="color: var(--color-text-2)"
            >
              {a.organization}
              {a.project && <span> · {a.project}</span>}
            </p>
            <p
              class="mt-4 text-sm leading-relaxed"
              style="color: var(--color-text-1)"
            >
              {a.blurb}
            </p>
            {a.href && (
              <a
                href={a.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider"
              >
                See on {new URL(a.href).hostname.replace(/^www\./, "")}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="container-x mt-12 border-t pt-16 pb-32"
    style="border-color: var(--color-border)"
  >
    <p class="t-meta mb-3">[ certificates ]</p>
    <h2 class="t-h1 mb-10" style="color: var(--color-text-0)">Certificates</h2>
    <ul class="space-y-6">
      {
        certificates.map((c) => (
          <li
            class="rounded-2xl border p-8"
            style="border-color: var(--color-border); background: var(--color-bg-1);"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h3
                class="text-xl font-semibold"
                style="color: var(--color-text-0)"
              >
                {c.title}
              </h3>
              <span
                class="shrink-0 font-mono text-xs"
                style="color: var(--color-brand-500)"
              >
                {c.date}
              </span>
            </div>
            <p
              class="mt-1 font-mono text-xs"
              style="color: var(--color-text-2)"
            >
              {c.organization}
            </p>
            <p
              class="mt-4 text-sm leading-relaxed"
              style="color: var(--color-text-1)"
            >
              {c.blurb}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
