---
import Base from "~/layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("log");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---

<Base title={`${d.title} — Log — Donghyeon Kim`} description={d.summary}>
  <article class="container-x pt-32 pb-32">
    <a
      href="/log"
      class="font-mono text-xs uppercase tracking-wider"
      style="color: var(--color-text-2)"
    >
      ← Log
    </a>

    <header
      class="mt-8 mb-12 border-b pb-10"
      style="border-color: var(--color-border)"
    >
      <p class="t-meta mb-3">[ {d.category} ]</p>
      <h1 class="t-h1 max-w-4xl" style="color: var(--color-text-0)">
        {d.title}
      </h1>
      {
        d.summary && (
          <p
            class="mt-6 max-w-3xl text-lg leading-relaxed"
            style="color: var(--color-text-1)"
          >
            {d.summary}
          </p>
        )
      }
      {
        d.keywords.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-1.5">
            {d.keywords.map((k) => (
              <li
                class="rounded-md border px-2 py-0.5 font-mono text-[11px]"
                style="border-color: var(--color-border); color: var(--color-text-2);"
              >
                {k}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="log-prose max-w-3xl" style="color: var(--color-text-1)">
      <Content />
    </div>
  </article>
</Base>

<style is:global>
  .log-prose h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text-0);
  }
  .log-prose h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-0);
  }
  .log-prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .log-prose ol,
  .log-prose ul {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .log-prose ol {
    list-style: decimal;
  }
  .log-prose ul {
    list-style: none;
  }
  .log-prose ul li {
    position: relative;
    line-height: 1.7;
    padding-left: 0.75rem;
  }
  .log-prose ul li::before {
    content: "·";
    position: absolute;
    left: -0.5rem;
    color: var(--color-brand-500);
    font-weight: bold;
  }
  .log-prose li {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }
  .log-prose strong {
    color: var(--color-text-0);
    font-weight: 600;
  }
  .log-prose code {
    background: var(--color-bg-2);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    color: var(--color-text-0);
    font-family: var(--font-mono);
  }
  .log-prose pre {
    background: var(--color-bg-1);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 1.25rem 0;
  }
  .log-prose pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
    color: var(--color-text-0);
  }
  .log-prose table {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .log-prose th,
  .log-prose td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }
  .log-prose th {
    color: var(--color-text-2);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.7rem;
  }
  .log-prose a {
    color: var(--color-brand-500);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
