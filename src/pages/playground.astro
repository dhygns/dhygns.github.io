---
import Base from "~/layouts/Base.astro";
import ShaderCard from "~/components/Hero/playground/ShaderCard.tsx";
import causticsSrc from "~/components/Hero/caustics.glsl?raw";
import warpSrc from "~/components/Hero/playground/domainWarping.glsl?raw";
import synthSrc from "~/components/Hero/playground/textureSynth.glsl?raw";

const demos = [
  {
    title: "Lightfield Caustics",
    blurb:
      "The hero shader. Light refracted through water as a metaphor for the lightfield rendering used in the Live Window AR HUD.",
    related: { label: "Live Window project", href: "/projects/live-window" },
    src: causticsSrc,
    accent: "#FF6B35",
  },
  {
    title: "Domain Warping Fluid",
    blurb:
      "Three-level fbm warping (Inigo Quilez classic). Slow oils flow under the cursor. Cheap on integrated GPUs.",
    related: null,
    src: warpSrc,
    accent: "#FFA37A",
  },
  {
    title: "Texture Synthesis Field",
    blurb:
      "Multi-octave noise quantized into bands. Visual analog of the texture-synthesis technique in Samsung Ambient Mode (patent WO2019135475).",
    related: { label: "Ambient Mode project", href: "/projects/ambient-mode" },
    src: synthSrc,
    accent: "#FF8454",
  },
];
---

<Base
  title="Playground — Donghyeon Kim"
  description="Live shader demos. Lightfield caustics, domain warping, texture synthesis — written in GLSL."
>
  <section class="container-x pt-32 pb-12">
    <p class="t-meta mb-3">[ playground ]</p>
    <h1 class="t-h1 max-w-3xl" style="color: var(--color-text-0)">
      A small gallery of shaders I wrote for this site.
    </h1>
    <p
      class="mt-6 max-w-2xl text-lg leading-relaxed"
      style="color: var(--color-text-1)"
    >
      Each card runs a real fragment shader in your browser. Move the mouse
      across them — they respond. Source is plain GLSL, ~30 lines each.
    </p>
  </section>

  <section class="container-x pb-32">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        demos.map((d, i) => (
          <article
            class={`flex flex-col overflow-hidden rounded-2xl border ${
              i === 0 ? "md:col-span-2" : ""
            }`}
            style="border-color: var(--color-border); background: var(--color-bg-1);"
          >
            {/* Shader canvas */}
            <div class="relative aspect-video w-full overflow-hidden">
              <ShaderCard client:visible fragSource={d.src} />
            </div>

            {/* Body */}
            <div class="border-t p-6" style="border-color: var(--color-border)">
              <div class="flex items-baseline justify-between gap-4">
                <h2
                  class="text-xl font-semibold"
                  style="color: var(--color-text-0)"
                >
                  {d.title}
                </h2>
                <span
                  aria-hidden="true"
                  class="inline-block h-2 w-8"
                  style={`background: ${d.accent};`}
                />
              </div>
              <p
                class="mt-3 text-sm leading-relaxed"
                style="color: var(--color-text-1)"
              >
                {d.blurb}
              </p>
              {d.related && (
                <a
                  href={d.related.href}
                  class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider"
                >
                  {d.related.label}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <p
      class="mt-12 max-w-2xl font-mono text-xs"
      style="color: var(--color-text-2)"
    >
      Shaders disabled if your OS reports prefers-reduced-motion or your
      device is mobile and narrow.
    </p>
  </section>
</Base>
