---
import Base from "~/layouts/Base.astro";
---

<Base
  title="404 — Donghyeon Kim"
  description="The page you're looking for doesn't exist."
>
  <section class="container-x flex min-h-[80svh] flex-col justify-center pt-32 pb-20">
    <p
      class="font-mono text-xs"
      style="color: var(--color-brand-500)"
    >
      [ 404 / not_found ]
    </p>
    <h1 class="t-display mt-4 max-w-3xl" style="color: var(--color-text-0)">
      That route hasn't shipped yet.
    </h1>
    <p
      class="mt-6 max-w-xl text-lg leading-relaxed"
      style="color: var(--color-text-1)"
    >
      Probably an old link or a typo. Try one of these instead:
    </p>

    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 font-mono text-sm">
      <li><a href="/">/ home</a></li>
      <li><a href="/projects">/ projects</a></li>
      <li><a href="/experience">/ experience</a></li>
      <li><a href="/log">/ log</a></li>
      <li><a href="/playground">/ playground</a></li>
    </ul>
  </section>
</Base>
